  <script>
    // Mobile menu toggle
    const menuBtn = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    // Sign-in validation
    const form = document.getElementById('signinForm');
    const emailEl = document.getElementById('email');
    const passEl = document.getElementById('password');
    const emailError = document.getElementById('emailError');
    const passError = document.getElementById('passError');
    const submitBtn = document.getElementById('submitBtn');
    const formMessage = document.getElementById('formMessage');

    function validateEmail(email) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }
    function showError(el, msg) { el.textContent = msg; el.classList.remove('hidden'); }
    function hideError(el) { el.textContent = ''; el.classList.add('hidden'); }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError(emailError);
      hideError(passError);
      formMessage.textContent = '';
      form.classList.remove('shake');

      const email = emailEl.value.trim();
      const password = passEl.value;
      let hasError = false;

      if (!validateEmail(email)) {
        showError(emailError, 'Please enter a valid email address.');
        hasError = true;
      }
      if (password.length < 6) {
        showError(passError, 'Password must be at least 6 characters.');
        hasError = true;
      }

      if (hasError) {
        form.classList.add('shake');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Signing in...';

      await new Promise(r => setTimeout(r, 900));

      if (email.endsWith('@example.com') && password === 'password123') {
        formMessage.textContent = 'Sign in successful! Redirecting...';
        formMessage.className = 'text-center text-green-600 mt-2';
        setTimeout(() => window.location.href = '#', 1200);
      } else {
        formMessage.textContent = 'Invalid credentials. Try again.';
        formMessage.className = 'text-center text-red-600 mt-2';
      }

      submitBtn.disabled = false;
      submitBtn.textContent = 'Sign In';
    });
  </script>

