    <!-- JavaScript for basic UI interactivity (Mobile Menu, Search Button effect) -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const mobileMenuButton = document.getElementById('mobile-menu-button');
            const mobileMenu = document.getElementById('mobile-menu');
            const searchButton = document.getElementById('search-button');

            // 1. Mobile Menu Toggle
            if (mobileMenuButton && mobileMenu) {
                mobileMenuButton.addEventListener('click', () => {
                    mobileMenu.classList.toggle('hidden');
                });

                // Close menu when a link is clicked
                const mobileLinks = mobileMenu.querySelectorAll('a');
                mobileLinks.forEach(link => {
                    link.addEventListener('click', () => {
                        mobileMenu.classList.add('hidden');
                    });
                });
            }

            // 2. Search Button Click Effect (Frontend only simulation)
            if (searchButton) {
                searchButton.addEventListener('click', () => {
                    const searchInput = document.getElementById('search-input');
                    const skill = searchInput.value.trim();
                    
                    // Simple console log to show what would be searched
                    console.log(`Searching for skill: "${skill || 'All Skills'}"`);

                    // Visual feedback: briefly change button text
                    searchButton.innerHTML = 'Searching...';
                    searchButton.classList.add('bg-gray-500', 'pointer-events-none');
                    searchButton.classList.remove('bg-skill-primary', 'hover-skill-primary');

                    setTimeout(() => {
                        searchButton.innerHTML = searchButton.getAttribute('data-original-text') || (window.innerWidth >= 768 ? 'Search Skill' : 'Find Talent');
                        searchButton.classList.remove('bg-gray-500', 'pointer-events-none');
                        searchButton.classList.add('bg-skill-primary', 'hover-skill-primary');
                        
                        // Clear input visually after a 'search' action
                        searchInput.value = '';

                        // In a real app, this is where a fetch call would go to load results
                        // For now, we simulate success
                        alertBox.show('Search initiated! Results would appear here.', 'success');
                    }, 1000);
                });

                // Store original text and handle responsive text change
                const updateSearchButtonText = () => {
                    const originalText = window.innerWidth >= 768 ? 'Search Skill' : 'Find Talent';
                    searchButton.setAttribute('data-original-text', originalText);
                    if (searchButton.innerHTML !== 'Searching...') {
                        searchButton.innerHTML = originalText;
                    }
                };
                window.addEventListener('resize', updateSearchButtonText);
                updateSearchButtonText(); // Initial call
            }

            // 3. Custom Alert/Message Box Functionality (Replacing alert())
            const alertBox = {
                // Creates and shows a dynamic alert box at the top of the viewport
                show: (message, type = 'info') => {
                    let box = document.getElementById('custom-alert');
                    if (!box) {
                        box = document.createElement('div');
                        box.id = 'custom-alert';
                        box.className = 'fixed top-4 left-1/2 transform -translate-x-1/2 px-6 py-3 rounded-xl shadow-2xl transition-opacity duration-300 opacity-0 z-[100] max-w-sm w-full text-center font-semibold text-white';
                        document.body.appendChild(box);
                    }

                    // Set colors based on type
                    let bgColor = 'bg-gray-700';
                    if (type === 'success') bgColor = 'bg-green-600';
                    else if (type === 'error') bgColor = 'bg-red-600';
                    else if (type === 'warning') bgColor = 'bg-yellow-600';

                    box.className = box.className.replace(/bg-[a-z]+-\d+/, bgColor);
                    box.classList.add(bgColor);
                    box.textContent = message;

                    // Show the box
                    setTimeout(() => box.classList.remove('opacity-0'), 10);

                    // Hide the box after 3 seconds
                    setTimeout(() => box.classList.add('opacity-0'), 3000);
                }
            };
        });
    </script>

